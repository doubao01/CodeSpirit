<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>false</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>false</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <RootNamespace>CodeSpiritVsixTemplate</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="CodeSpiritSnippets.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\Icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\Preview.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Snippets\*.snippet">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>Snippets</VSIXSubPath>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <ProjectTemplateSourceDir>$(MSBuildProjectDirectory)\ProjectTemplates\CodeSpirit.LibraryManagement</ProjectTemplateSourceDir>
    <ProjectTemplateZip>$(MSBuildProjectDirectory)\obj\CodeSpiritTemplate\CodeSpirit.LibraryManagement.zip</ProjectTemplateZip>
    <GetVsixSourceItemsDependsOn>$(GetVsixSourceItemsDependsOn);PackageProjectTemplate</GetVsixSourceItemsDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ProjectTemplates\**\*.cs" />
    <None Remove="ProjectTemplates\**" />
    <Content Include="$(ProjectTemplateZip)" IncludeInVSIX="true" VSIXSubPath="ProjectTemplates" />
  </ItemGroup>

  <Target Name="PackageProjectTemplate" BeforeTargets="AssignTargetPaths">
    <MakeDir Directories="$(MSBuildProjectDirectory)\obj\CodeSpiritTemplate" />
    <ZipDirectory SourceDirectory="$(ProjectTemplateSourceDir)"
                  DestinationFile="$(ProjectTemplateZip)"
                  Overwrite="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.8.2365">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <VsSDKTargetsPath>$(PkgMicrosoft_VSSDK_BuildTools)\tools\vssdk\Microsoft.VsSDK.targets</VsSDKTargetsPath>
    <CustomAfterMicrosoftCommonTargets Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('$(VsSDKTargetsPath)')">$(VsSDKTargetsPath)</CustomAfterMicrosoftCommonTargets>
  </PropertyGroup>
</Project>
