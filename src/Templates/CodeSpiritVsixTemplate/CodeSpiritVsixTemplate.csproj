<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>CodeSpiritVsixTemplate</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS2008</NoWarn>
    <VsixPackageDir>$(MSBuildProjectDirectory)\obj\CodeSpiritVsix\</VsixPackageDir>
  </PropertyGroup>

  <PropertyGroup>
    <ProjectTemplateSourceDir>$(MSBuildProjectDirectory)\ProjectTemplates\CodeSpirit.LibraryManagement</ProjectTemplateSourceDir>
    <ProjectTemplateZip>$(MSBuildProjectDirectory)\obj\CodeSpiritTemplate\CodeSpirit.LibraryManagement.zip</ProjectTemplateZip>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ProjectTemplates\**\*.cs" />
    <None Remove="ProjectTemplates\**" />
    <None Remove="$(ProjectTemplateZip)" />
    <VsixSnippet Include="Snippets\*.snippet" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="PackageProjectTemplate">
    <MakeDir Directories="$(MSBuildProjectDirectory)\obj\CodeSpiritTemplate" />
    <ZipDirectory SourceDirectory="$(ProjectTemplateSourceDir)"
                  DestinationFile="$(ProjectTemplateZip)"
                  Overwrite="true" />
  </Target>

  <Target Name="BuildVsix" AfterTargets="Build" DependsOnTargets="PackageProjectTemplate">
    <PropertyGroup>
      <TargetVsixContainer>$(TargetDir)CodeSpiritVsixTemplate.vsix</TargetVsixContainer>
    </PropertyGroup>

    <RemoveDir Directories="$(VsixPackageDir)" />
    <MakeDir Directories="$(VsixPackageDir)ProjectTemplates;$(VsixPackageDir)Snippets;$(VsixPackageDir)Resources" />

    <Copy SourceFiles="source.extension.vsixmanifest" DestinationFiles="$(VsixPackageDir)extension.vsixmanifest" />
    <Copy SourceFiles="[Content_Types].xml" DestinationFiles="$(VsixPackageDir)[Content_Types].xml" />
    <Copy SourceFiles="LICENSE.txt" DestinationFiles="$(VsixPackageDir)LICENSE.txt" />
    <Copy SourceFiles="CodeSpiritSnippets.pkgdef" DestinationFiles="$(VsixPackageDir)CodeSpiritSnippets.pkgdef" />
    <Copy SourceFiles="Resources\Icon.png" DestinationFiles="$(VsixPackageDir)Resources\Icon.png" />
    <Copy SourceFiles="Resources\Preview.png" DestinationFiles="$(VsixPackageDir)Resources\Preview.png" />
    <Copy SourceFiles="@(VsixSnippet)" DestinationFolder="$(VsixPackageDir)Snippets" />
    <Copy SourceFiles="$(ProjectTemplateZip)" DestinationFiles="$(VsixPackageDir)ProjectTemplates\CodeSpirit.LibraryManagement.zip" />

    <ZipDirectory SourceDirectory="$(VsixPackageDir)"
                  DestinationFile="$(TargetVsixContainer)"
                  Overwrite="true" />

    <Message Importance="high" Text="$(MSBuildProjectName) -&gt; $(TargetVsixContainer)" />
  </Target>
</Project>