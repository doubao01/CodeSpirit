<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <CodeSpiritVersion Condition="'$(CodeSpiritVersion)' == ''">0.1.0</CodeSpiritVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeSpirit.Core" Version="$(CodeSpiritVersion)" />
    <PackageReference Include="CodeSpirit.Infrastructure" Version="$(CodeSpiritVersion)" />
    <PackageReference Include="CodeSpirit.SourceGenerator" Version="$(CodeSpiritVersion)"
      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Pages\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Components\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Reports\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>